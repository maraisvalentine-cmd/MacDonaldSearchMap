{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Overlay java-rest-controllers",
  "description": "Resserre le pivot de base pour une API REST : chaque champ est un endpoint décrit par une extension `http`. Validé EN PLUS de engine/contracts/pivot.schema.json.",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["http"],
        "properties": {
          "render": {
            "type": "object",
            "properties": {
              "interaction_method": { "const": "http-call" }
            }
          },
          "http": {
            "type": "object",
            "required": ["method", "path", "responses", "security"],
            "properties": {
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
              "path": { "type": "string", "pattern": "^/" },
              "path_params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
              "query_params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
              "headers": { "type": "array", "items": { "$ref": "#/$defs/param" } },
              "consumes": { "type": "array", "items": { "type": "string" } },
              "produces": { "type": "array", "items": { "type": "string" } },
              "request_body": {
                "type": ["object", "null"],
                "properties": {
                  "type": { "type": "string" },
                  "fields": { "type": "array", "items": { "$ref": "#/$defs/bodyField" } }
                }
              },
              "responses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                    "when": { "type": "string" },
                    "body_type": { "type": ["string", "null"] }
                  }
                }
              },
              "security": {
                "type": "object",
                "required": ["authenticated"],
                "properties": {
                  "authenticated": { "type": "boolean" },
                  "roles": { "type": "array", "items": { "type": "string" }, "description": "Rôles ou autorités requis." },
                  "checked_in": { "type": "array", "items": { "enum": ["controller", "service", "config", "unknown"] } }
                }
              },
              "source": {
                "type": "object",
                "properties": {
                  "file": { "type": "string" },
                  "line": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "unit_test_candidates": {
      "description": "Cas limites techniques à couvrir par des tests unitaires, pas par Cucumber.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint", "kind", "detail"],
        "properties": {
          "endpoint": { "type": "string" },
          "kind": { "enum": ["bounds", "format", "required-field", "authorization", "conversion", "other"] },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "param": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "default": {}
      }
    },
    "bodyField": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "constraints": { "type": "string" }
      }
    }
  }
}
